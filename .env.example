# Free NVIDIA API key: https://build.nvidia.com/settings
# Leave this empty until you are ready. Never commit a real key.
NVIDIA_API_KEY=

# OpenAI-compatible base URL. This build refuses hosts other than NVIDIA's
# free endpoint unless you explicitly opt in with NVIDIA_ALLOW_HOSTS.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TEMPERATURE=0
NVIDIA_MAX_TOKENS=1800

# Paid sandbox. Ignored. Execution stays on the local locked-down runner.
E2B_API_KEY=

# Optional. Leave empty to use the local read-only SQLite sample database.
# Example for your own server (SELECT-only role): 
# DB_CONNECTION_STRING=postgresql://readonly_user:pass@localhost:5432/analytics
DB_CONNECTION_STRING=

# Not enabled. Traces are written to logs/traces.jsonl on this machine.
LANGSMITH_API_KEY=

HITL_ENABLED=false
SANDBOX_BACKEND=local
SANDBOX_TIMEOUT_SECONDS=30
MAX_ITERATIONS=8
MAX_TOOL_CALLS=10
TOKEN_BUDGET=12000
